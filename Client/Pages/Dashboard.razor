@page "/dashboard"
@using GolfStatsApp.Client.Services
@inject HttpClient Http
@inject AuthState Auth

@code {
    private bool Enabled => FeatureFlags.Dashboard;
    private List<TeamStats> Stats = new();
    private string currentSortColumn = "TeamName";
    private bool sortAscending = true;
    private bool isLoaded;
    private string? loadError;

    private static readonly Dictionary<string, Func<TeamStats, IComparable>> Sorters = new()
    {
        ["TeamName"] = s => s.TeamName,
        ["OverallAverage"] = s => s.OverallAverage,
        ["AverageWithRoster"] = s => s.AverageWithRoster,
        ["BestTournamentScore"] = s => s.BestTournamentScore,
        ["WorstTournamentScore"] = s => s.WorstTournamentScore,
        ["LongestRosterStreak"] = s => s.LongestRosterStreak,
        ["Wins"] = s => s.Wins,
        ["Majors"] = s => s.Majors,
        ["SignatureEvents"] = s => s.SignatureEvents,
        ["Regulars"] = s => s.Regulars,
    };

    private void ApplySort()
    {
        if (!Sorters.TryGetValue(currentSortColumn, out var key)) return;
        Stats = (sortAscending ? Stats.OrderBy(key) : Stats.OrderByDescending(key)).ToList();
    }

    private void SortByColumn(string columnName)
    {
        if (currentSortColumn == columnName)
            sortAscending = !sortAscending;
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }

        ApplySort();
    }

    private MarkupString SortIcon(string column)
    {
        if (currentSortColumn != column) return new MarkupString("");

        var icon = sortAscending ? "▲" : "▼";
        return new MarkupString($" {icon}");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Enabled) return;
        Auth.Changed += OnAuthChanged;
        _ = Auth.EnsureLoadedAsync();
        try
        {
            Stats = await Http.GetFromJsonAsync<List<TeamStats>>("api/teams") ?? new List<TeamStats>();
            ApplySort();
        }
        catch (HttpRequestException)
        {
            loadError = "Could not load team stats. Please try again.";
        }
        isLoaded = true;
    }

    private void OnAuthChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Changed -= OnAuthChanged;
}
@implements IDisposable
@if (!Enabled)
{
    <PageTitle>Not found</PageTitle>
    <p>Sorry, there's nothing at this address.</p>
    return;
}
<PageTitle>Team Dashboard</PageTitle>

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2 mb-2">
    <h1 class="mb-0">Team Dashboard</h1>
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (isLoaded && loadError is null)
        {
            <small class="text-muted">@Stats.Count teams &middot; <span class="d-none d-sm-inline">click a column header to sort</span></small>
            <a class="btn btn-sm btn-outline-success" href="api/teams/export?format=csv" download>Export CSV</a>
            <a class="btn btn-sm btn-outline-success" href="api/teams/export?format=xlsx" download>Export Excel</a>
        }
        @if (Auth.User.IsAdmin)
        {
            <a class="btn btn-sm btn-success" href="admin">Edit results</a>
        }
    </div>
</div>

@if (!isLoaded)
{
    <div class="d-flex align-items-center gap-2 text-muted py-5 justify-content-center">
        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
        <span>Loading stats...</span>
    </div>
}
else if (loadError is not null)
{
    <div class="alert alert-danger">@loadError</div>
}
else
{
    <div class="stats-table-wrapper">
    <table class="table table-striped table-hover stats-table table-cards">
        <thead>
            <tr>
                <th class="sortable" scope="col" @onclick='() => SortByColumn("TeamName")'>
                    Team <span class="sort-icon">@SortIcon("TeamName")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("OverallAverage")'>
                    Overall Avg <span class="sort-icon">@SortIcon("OverallAverage")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("AverageWithRoster")'>
                    Avg (Roster) <span class="sort-icon">@SortIcon("AverageWithRoster")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("BestTournamentScore")'>
                    Best Score <span class="sort-icon">@SortIcon("BestTournamentScore")</span>
                </th>
                <th scope="col">Best Tourney</th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("WorstTournamentScore")'>
                    Worst Score <span class="sort-icon">@SortIcon("WorstTournamentScore")</span>
                </th>
                <th scope="col">Worst Tourney</th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("LongestRosterStreak")'>
                    Streak <span class="sort-icon">@SortIcon("LongestRosterStreak")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("Wins")'>
                    Wins <span class="sort-icon">@SortIcon("Wins")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("Majors")'>
                    Majors <span class="sort-icon">@SortIcon("Majors")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("SignatureEvents")'>
                    Signatures <span class="sort-icon">@SortIcon("SignatureEvents")</span>
                </th>
                <th class="sortable text-end" scope="col" @onclick='() => SortByColumn("Regulars")'>
                    Regulars <span class="sort-icon">@SortIcon("Regulars")</span>
                </th>
            </tr>
        </thead>
        <tbody>
        @foreach (var team in Stats)
        {
            <tr>
                <td data-label="Team">@team.TeamName</td>
                <td class="text-end" data-label="Overall Avg">@team.OverallAverage</td>
                <td class="text-end" data-label="Avg (Roster)">@team.AverageWithRoster</td>
                <td class="text-end" data-label="Best Score">@team.BestTournamentScore</td>
                <td data-label="Best Tourney">@team.BestTournament</td>
                <td class="text-end" data-label="Worst Score">@team.WorstTournamentScore</td>
                <td data-label="Worst Tourney">@team.WorstTournament</td>
                <td class="text-end" data-label="Streak">@team.LongestRosterStreak</td>
                <td class="text-end" data-label="Wins">@team.Wins</td>
                <td class="text-end" data-label="Majors">@team.Majors</td>
                <td class="text-end" data-label="Signatures">@team.SignatureEvents</td>
                <td class="text-end" data-label="Regulars">@team.Regulars</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
