@* App-owned chart wrapper: finish-position histogram (vertical CSS bars). *@
<figure class="mb-3" aria-label="Finish distribution for @Golfer.PlayerName">
    <figcaption class="small fw-semibold mb-1">Finish distribution — @Golfer.PlayerName</figcaption>
    <div class="d-flex align-items-end gap-1" style="height:120px">
        @foreach (var (label, value) in Buckets)
        {
            var h = Max > 0 ? value / Max * 100 : 0;
            <div class="flex-fill d-flex flex-column justify-content-end text-center small" style="height:100%" title="@label: @value.ToString("P1")">
                <div class="@(label == FinishBucketNames.MissedCut ? "bg-danger" : "bg-success") rounded-top" style="height:@h.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        }
    </div>
    <div class="d-flex gap-1 small text-muted">
        @foreach (var (label, value) in Buckets)
        {
            <div class="flex-fill text-center">@label<br />@value.ToString("P0")</div>
        }
    </div>
</figure>

@code {
    [Parameter, EditorRequired] public GolferPrediction Golfer { get; set; } = new();

    private IEnumerable<(string Label, double Value)> Buckets =>
        FinishBucketNames.All.Where(Golfer.FinishBuckets.ContainsKey).Select(k => (k, Golfer.FinishBuckets[k]));

    private double Max => Golfer.FinishBuckets.Count == 0 ? 0 : Golfer.FinishBuckets.Values.Max();
}
